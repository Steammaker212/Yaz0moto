<?xml version="1.0"?>
<!-- Built on the Yaz0moto theme: its shapes and icons in this theme's colours. -->
<theme
		format="1.0"
		name="Underwater"
		version="1.0"
		creator="RoadrunnerWMC"
		description="This theme can help you visualize underwater levels."
		base="Yaz0moto"
		>

	<variables>
		<var name="accent" value="#1FA595" />
		<var name="background" value="#E3F7EE" />
		<var name="text" value="#10332F" />
	</variables>

	<!-- This theme's own level view colours -->
	<colors file="levelview.xml" />

</theme>
